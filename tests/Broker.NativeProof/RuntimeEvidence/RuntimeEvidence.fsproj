<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode><NuGetLockFilePath>RuntimeEvidence.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DataRootPolicy.fsi"/><Compile Include="DataRootPolicy.fs"/>
    <Compile Include="GrowingLogEvidence.fsi"/><Compile Include="GrowingLogEvidence.fs"/>
    <Compile Include="FailureDiagnostic.fs"/><Compile Include="Codec.fs"/><Compile Include="PolicyClosure.fs"/><Compile Include="PolicyInvocation.fs"/><Compile Include="Program.fs"/>
  </ItemGroup>
</Project>
