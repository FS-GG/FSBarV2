# GAME-RENDER-ADOPT-01.8 (FS-GG/.github#5180, Outcome FS-GG/.github#5179).
#
# No published FS.GG.Game.Render package carries RendererSelection yet (0.17.0 ships only Adapter and
# DefaultKeymap), and the retained SVG surface lives in the unpacked Render.Browser project. Until a package
# ships them, the BAR client compiles byte-exact copies of these four FS.GG.Game sources, pinned to one upstream
# commit and verified by scripts/check-game-render-pin.py. They are never edited here. Replace them with the
# package reference and delete this directory and both Upstream directories when it publishes.
UPSTREAM_REPOSITORY=FS-GG/FS.GG.Game
UPSTREAM_COMMIT=d602c2d4bfb014498d3677ea4c5f21b8a3f7046b
# FILE_<name>=<local path> <upstream path> <sha256>
FILE_RendererSelection.fsi=src/Broker.Browser.Render/Upstream/RendererSelection.fsi src/Game.Render/RendererSelection.fsi 4db6cb56f50bc64afe9fb8488bc9b5e8187bd0455be9200cba7a22e65ddaefce
FILE_RendererSelection.fs=src/Broker.Browser.Render/Upstream/RendererSelection.fs src/Game.Render/RendererSelection.fs d72d3de95ac9cb79309b2c4c0c32664a2f6fd8a16c62b7000ddd67800eafb056
FILE_SvgSurface.fsi=src/Broker.Browser.Render.Host/Upstream/SvgSurface.fsi src/Render.Browser/SvgSurface.fsi 3c85b380ba1f1a44fe98a7fb08b8f3cc2478b77679a0ccb815c62d0b6614c824
FILE_SvgSurface.fs=src/Broker.Browser.Render.Host/Upstream/SvgSurface.fs src/Render.Browser/SvgSurface.fs fde2d64448cd35e62433ee52d55d9e8b5a8f965b75440052984d230a9d680619
# Directories that may hold only the files named above.
DIRECTORY=src/Broker.Browser.Render/Upstream
DIRECTORY=src/Broker.Browser.Render.Host/Upstream
