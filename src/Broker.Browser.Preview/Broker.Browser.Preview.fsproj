  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broker.Protocol\Broker.Protocol.fsproj" />
    <ProjectReference Include="..\Broker.Browser.Gateway\Broker.Browser.Gateway.fsproj" />
    <ProjectReference Include="..\Broker.Browser.Contracts\Broker.Browser.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Grpc.Net.Client" Version="2.76.0" /></ItemGroup>
</Project>
