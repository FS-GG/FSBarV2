<Project Sdk="Microsoft.NET.Sdk">
  <!-- GAME-RENDER-ADOPT-01.8 (FS-GG/.github#5180, Outcome #5179): the BAR observable game-state type and its
       Game.Render renderer-selection client. Portable F#: compiled by .NET for the unit tests and by Fable for
       the browser. The Fable-only DOM host is src/Broker.Browser.Render.Host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- The pinned Upstream sources are byte-exact FS.GG.Game files built under their own project settings. -->
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>FS0025;FS0026;FS0052;FS0064</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Upstream/RendererSelection.fsi" />
    <Compile Include="Upstream/RendererSelection.fs" />
    <Compile Include="BarGameState.fsi" />
    <Compile Include="BarGameState.fs" />
    <Compile Include="BarObservationJson.fsi" />
    <Compile Include="BarObservationJson.fs" />
    <Compile Include="BarScene.fsi" />
    <Compile Include="BarScene.fs" />
    <Compile Include="BarSynthetic.fsi" />
    <Compile Include="BarSynthetic.fs" />
    <Compile Include="BarClient.fsi" />
    <Compile Include="BarClient.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="[5.3.0]" />
    <PackageReference Include="Fable.Elmish" Version="[5.0.2]" />
    <PackageReference Include="FS.GG.UI.Scene" Version="[0.32.3]" />
  </ItemGroup>
</Project>
